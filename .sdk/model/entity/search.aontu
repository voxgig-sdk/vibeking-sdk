# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: {
    count: {
      h: "Count"
      n: "count"
      r: false
      t: "`$INTEGER`"
    }
    hasMore: {
      h: "Has More"
      n: "hasMore"
      r: false
      t: "`$BOOLEAN`"
    }
    html: {
      h: "Html"
      n: "html"
      r: false
      sh: "Pre-rendered HTML rows for this page."
      t: "`$STRING`"
    }
    page: {
      h: "Page"
      n: "page"
      r: false
      t: "`$INTEGER`"
    }
    q: {
      h: "Q"
      n: "q"
      r: false
      sh: "The echoed search query."
      t: "`$STRING`"
    }
    total: {
      h: "Total"
      n: "total"
      r: false
      t: "`$INTEGER`"
    }
  }

  name: "search"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/search"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "love"
                k: "query"
                n: "q"
                or: "q"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/search"
          q: {
            exist: [
              "q"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "search"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
