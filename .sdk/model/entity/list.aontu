# Entity: list

main: kit: entity: list: {

  alias: field: {}

  fields: {
    count: {
      h: "Count"
      n: "count"
      r: false
      sh: "Number of products returned in this page."
      t: "`$INTEGER`"
    }
    hasMore: {
      h: "Has More"
      n: "hasMore"
      r: false
      t: "`$BOOLEAN`"
    }
    html: {
      h: "Html"
      n: "html"
      r: false
      sh: "Pre-rendered HTML rows for this page."
      t: "`$STRING`"
    }
    page: {
      h: "Page"
      n: "page"
      r: false
      t: "`$INTEGER`"
    }
    total: {
      h: "Total"
      n: "total"
      r: false
      sh: "Total number of products matching the query."
      t: "`$INTEGER`"
    }
  }

  name: "list"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/list"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "category"
                or: "category"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "trending"
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/list"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "list"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
