# Entity: product

main: kit: entity: product: {

  alias: field: {}

  fields: {
    ai_tool: {
      h: "Ai Tool"
      n: "ai_tool"
      r: false
      sh: "The AI tool used to build the product."
      t: "`$STRING`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      t: "`$STRING`"
    }
    created_at: {
      h: "Created At"
      n: "created_at"
      r: false
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$INTEGER`"
    }
    maker: {
      h: "Maker"
      n: "maker"
      r: false
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      t: "`$STRING`"
    }
    tagline: {
      h: "Tagline"
      n: "tagline"
      r: false
      t: "`$STRING`"
    }
    upvotes: {
      h: "Upvotes"
      n: "upvotes"
      r: false
      t: "`$INTEGER`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      sh: "The product's real external URL."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "product"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/products"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "ai_tool"
                or: "ai_tool"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "category"
                or: "category"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "100"
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "search"
                or: "search"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "top"
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/products"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "products"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/products/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/products/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "products"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
